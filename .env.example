# 複製這份成 .env，本機開發先用 docker-compose 起的 Postgres/Redis 就好
APP_ENV=local

# 本機：docker-compose 起的 Postgres（含 pgvector extension）
# 帳號密碼要跟 docker-compose.yml 裡的 POSTGRES_USER / POSTGRES_PASSWORD 逐字一致：
#   user=city_soul（有底線）, password=city_soul_dev, db=city_soul
DATABASE_URL=postgresql+psycopg://city_soul:city_soul_dev@localhost:5432/city_soul

# 本機：docker-compose 起的 Redis
REDIS_URL=redis://localhost:6379/0

# 之後接 GCP 時，把上面兩個換成：
#   DATABASE_URL=postgresql+psycopg://<user>:<pass>@/<db>?host=/cloudsql/<INSTANCE_CONNECTION_NAME>
#   REDIS_URL=redis://<MEMORYSTORE_IP>:6379/0
# 不需要改任何程式碼，只換 .env

# Session Token（S6）簽章金鑰，本機開發用假金鑰即可，正式環境要用 GCP Secret Manager
# 掛載、且跟這裡的值不同（見 SDD 第6節）。
SESSION_TOKEN_SECRET=local-dev-session-secret-do-not-use-in-prod

# Encounter Token（S2，15分鐘相遇憑證）簽章金鑰。務必跟 SESSION_TOKEN_SECRET
# 是不同的值——這正是「兩種 token 不可互相冒充」這條規則的實際落地方式。
ENCOUNTER_TOKEN_SECRET=local-dev-encounter-secret-do-not-use-in-prod

GCP_PROJECT_ID=citysoul
GCP_LOCATION=asia-east1
GEMINI_MODEL=gemini-3.5-flash
GCP_SECRET_NAME=vertex-ai-sa-key
GCP_SECRET_VERSION=latest