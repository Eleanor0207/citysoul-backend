# 複製這份成 .env，本機開發先用 docker-compose 起的 Postgres/Redis 就好
APP_ENV=local

# 本機：docker-compose 起的 Postgres（含 pgvector extension）
# 帳號密碼要跟 docker-compose.yml 裡的 POSTGRES_USER / POSTGRES_PASSWORD 逐字一致：
#   user=city_soul（有底線）, password=city_soul_dev, db=city_soul
DATABASE_URL=postgresql+psycopg://city_soul:city_soul_dev@localhost:5432/city_soul

# 本機：docker-compose 起的 Redis
REDIS_URL=redis://localhost:6379/0

# 之後接 GCP 時，把上面兩個換成：
#   DATABASE_URL=postgresql+psycopg://<user>:<pass>@/<db>?host=/cloudsql/<INSTANCE_CONNECTION_NAME>
#   REDIS_URL=redis://<MEMORYSTORE_IP>:6379/0
# 不需要改任何程式碼，只換 .env

# Session Token（S6）簽章金鑰，本機開發用假金鑰即可，正式環境要用 GCP Secret Manager
# 掛載、且跟這裡的值不同（見 SDD 第6節）。
SESSION_TOKEN_SECRET=local-dev-session-secret-do-not-use-in-prod

# Encounter Token（S2，15分鐘相遇憑證）簽章金鑰。務必跟 SESSION_TOKEN_SECRET
# 是不同的值——這正是「兩種 token 不可互相冒充」這條規則的實際落地方式。
ENCOUNTER_TOKEN_SECRET=local-dev-encounter-secret-do-not-use-in-prod

# Sense Token（S2-new，30分鐘感應憑證）簽章金鑰。三把金鑰必須兩兩不同——
# 只要有兩把相同，那兩種 token 就能互相冒充，SDD 第6節的分層形同虛設。
SENSE_TOKEN_SECRET=local-dev-sense-secret-do-not-use-in-prod

# ── GCP（見 docs/adr/0003-adc-over-service-account-keys.md）─────────────
#
# 這裡**沒有憑證欄位**，是刻意的。存取 Vertex AI 走 Application Default
# Credentials：
#
#   本機：  gcloud auth application-default login
#   正式：  Cloud Run 綁定的 service account，自動取得
#   CI：    Workload Identity Federation，換發短期 token
#
# 不要產生 service account 金鑰檔，也不要把金鑰放進 Secret Manager——那只是
# 把金鑰換個地方放，它仍然長期有效、仍然要輪替、仍然可能被寫進 log。
#
# 底下三個只是「呼叫哪個模型」，不是秘密。
GCP_PROJECT_ID=citysoul

# ⚠️ 不是 asia-east1。實測（2026-08）該區域**一個 Gemini 模型都沒有**，所有
# 名稱都回 404。SDD 寫的 asia-east1 是錯的。（資料庫可以放台灣，那是另一回事。）
GCP_LOCATION=global

# 用實測選的，不是猜的：2.5-flash-lite 回應 1.0s；3.5-flash 因為每輪固定先花
# 約 500 個 thinking token，同樣的問題要 4.8s。理由詳見 app/core/config.py。
# 要換回 3.5-flash 的話，**記得同時**把 GEMINI_MAX_OUTPUT_TOKENS 調到 1024
# 以上，否則會拿到講到一半的句子。
GEMINI_MODEL=gemini-2.5-flash-lite

# 模型輸出上限。放在設定而不是 prompt 文字裡——請模型「簡短回答」沒有保證，
# 而這個值直接決定單次呼叫的成本上限。
GEMINI_MAX_OUTPUT_TOKENS=256
GEMINI_TIMEOUT_SECONDS=8.0
# 開發測試主控台（/dev/console）。預設開著，本機開發不用設。
# 對外的正式部署要明確關掉：它會列出「有哪些玩家、有哪些地標」，那是內部資訊。
DEV_CONSOLE_ENABLED=true

# 全域（非單一玩家）每日對話上限，BE#65／SDD §18.6.4。
#
# usage_tier_limits 那一整套都是 per player per day，攔得住單一玩家濫用，
# 攔不住「1000 個玩家同時觸頂」——帳單是 1000 倍，而沒有任何閘門會擋。
#
# 留空＝不設限。封測期人數由發碼控制，這道閘門不需要啟用；**公開前必須設起來**。
# 觸頂時玩家看到的是角色口吻的保底句、HTTP 仍是 200，不是錯誤碼（§18.7.3）。
# 它是止血閥不是容量規劃：設得太貼近日常用量，正常的熱門時段就會把玩家推進保底句。
# GLOBAL_DIALOGUE_DAILY_LIMIT=
